PORT=3002
SERVICE_NAME=compression-service

# PostgreSQL
DB_HOST=compression-db
DB_PORT=5432
DB_NAME=compression_db
DB_USER=postgres
DB_PASS=postgres

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=compression-service-group

# External Services
FILE_REGISTRY_URL=http://file-registry:4000
STORAGE_GW_URL=http://storage-gateway:4001
CONFIG_URL=http://config-service:3005
METRICS_URL=http://metrics-service:3007

# Compression Settings
DEFAULT_ALGORITHM=gzip
MAX_FILE_SIZE_MB=500
LARGE_FILE_THRESHOLD_MB=10
