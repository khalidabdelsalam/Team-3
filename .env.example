NODE_ENV=development
PORT=3001
API_KEY=
MONGO_URI=mongodb://127.0.0.1:27017/webhook-db
MONGO_RETRY_CONNECTION_DELAY_MS=5000
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=events
KAFKA_STATUS_TOPIC=webhook-status
KAFKA_DEAD_LETTER_TOPIC=webhook-dead-letter
KAFKA_CLIENT_ID=webhook-service
KAFKA_GROUP_ID=webhook-service-group
KAFKA_RETRY_CONNECTION_DELAY_MS=5000
HTTP_TIMEOUT_MS=5000
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY_MS=2000
ENABLE_SAMPLE_WEBHOOK_SEED=false
SAMPLE_WEBHOOK_URL=
SAMPLE_WEBHOOK_NAME=sample-webhook-receiver
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=webhook-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
