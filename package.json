{
  "name": "scheduler-service",
  "version": "1.0.0",
  "description": "Scheduler microservice using Node.js, Kafka, and MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pm2:start": "pm2-runtime start ecosystem.config.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage --coverageDirectory=tests/coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "express": "^4.19.2",
    "mongoose": "^8.3.2",
    "kafkajs": "^2.2.4",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pm2": "^5.3.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "tests/coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/tracing.js"
    ]
  }
}
